{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic asset metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "media_type", "mime_type", "width", "height", "aspect_ratio", "source", "extractor_version", "extracted_at"],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "media_type": {"enum": ["image", "video"]},
    "mime_type": {"type": "string", "minLength": 1},
    "width": {"type": ["integer", "null"], "minimum": 1},
    "height": {"type": ["integer", "null"], "minimum": 1},
    "duration_seconds": {"type": ["number", "null"], "minimum": 0},
    "aspect_ratio": {"type": ["string", "null"], "pattern": "^[0-9]+:[0-9]+$"},
    "frame_rate": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "source": {"const": "deterministic"},
    "extractor_version": {"type": "string", "minLength": 1},
    "extracted_at": {"type": "string", "format": "date-time"}
  }
}
